ANTHROPIC_API_KEY=sk-ant-...
INTERAKT_API_KEY=...
INTERAKT_API_URL=https://api.interakt.ai/v1/public/message/

# Set to true during demo to compress escalation delays to 2 minutes
DEMO_MODE=true

# SQLite DB path
DB_PATH=./mmss.db

# MCP server port
MCP_PORT=8889

# Escalation chain phone numbers (with country code, e.g. +919876543210)
# For demo: use your/Trilok's phone so you can show live escalation
CALL_CENTRE_PHONE=+91XXXXXXXXXX
PHC_MO_PHONE=+91XXXXXXXXXX
CMO_PHONE=+91XXXXXXXXXX
NHM_PHONE=+91XXXXXXXXXX

# Notification mode:
#   log      → print alerts to console only (default, works without Interakt templates)
#   whatsapp → send via Interakt template API (requires approved templates)
NOTIFY_MODE=log
